# Redis broker/backend URL used by the Celery worker and beat (and the app).
# Inside the compose network the redis service is reachable as "redis".
REDIS_URL=redis://redis:6379/0

# Gotify push-notification server URL (used when notifications are wired up).
GOTIFY_URL=https://gotify.example.com

# Gotify application token used to send push notifications.
GOTIFY_TOKEN=your-gotify-app-token
