# Redis broker/backend URL used by the Celery worker and beat (and the app).
# Inside the compose network the redis service is reachable as "redis".
REDIS_URL=redis://redis:6379/0

# Gotify push-notification server URL (used when notifications are wired up).
GOTIFY_URL=https://gotify.example.com

# Gotify application token used to send push notifications.
GOTIFY_TOKEN=your-gotify-app-token

# Path to the Docker Engine API unix socket inside the worker container.
# The prod compose override mounts the host's /var/run/docker.sock there
# read-only; this value must match that mount.
DOCKER_SOCK=/var/run/docker.sock

# Path to the healthchecks yaml inside the worker container. The prod
# compose override mounts ./healthchecks.yaml at /config/healthchecks.yaml
# read-only; this value must match that mount.
HEALTHCHECKS_CONFIG=/config/healthchecks.yaml

# Host directory mounted read-only at /root/.docker in the worker (registry
# auth for the Docker image digest check). Leave unset to use $HOME/.docker
# on the host; set only if your docker config lives somewhere else.
# HOST_DOCKER_CONFIG=/path/on/host/.docker

# Host directory with the backups, mounted read-only at the SAME path in the
# worker for the backup-freshness healthcheck (issue #20). The worker reads
# the newest file's mtime there; the healthchecks.yaml entry points at the
# same path inside the container.
# BACKUP_DIR=/mnt/backups

# Timezone for the worker and beat containers, so Celery Beat's 06:00 apt
# check and 09:00 daily digest run at local time. Compose falls back to UTC
# when unset. Example: TZ=Europe/Copenhagen
TZ=UTC
